# Database Configuration
DB_USER=admin
DB_PW=your_password_here
DB_NAME=hexToBinaryTrainer2
DB_HOST=localhost
DB_PORT=5432

# API Configuration
ALLOWED_ORIGINS=["http://localhost:5173","https://yourdomain.com"]
FRONTEND_URL=https://yourdomain.com/trainer

# JWT Configuration (REQUIRED for authentication)
# Startup FAILS if this is missing, shorter than 32 chars, or left at the old default.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-jwt-secret-here-change-in-production

# Email-Change Token Key (REQUIRED in production, >= 32 chars)
# Fernet-encrypts the new email address inside the change-verification token (US-07).
# The built-in default is only safe for the test suite — using it in production makes
# every email-change token decryptable by anyone with repository access.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_CHANGE_KEY=your-email-change-key-here-change-in-production

# SMTP Configuration (REQUIRED for email notifications)
# Strato SMTP example:
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=your-email@your-domain.de
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@your-domain.de

# Optional: Database initialization timeout (seconds)
# DB_WAIT_TIMEOUT=60

# Optional: Cookie security (set to false for local development without HTTPS)
# COOKIE_SECURE=true


BASE_URL=http://localhost:8000