# Developer-local test database overrides (copy to .env.test — gitignored).
#
# Resolution order used by tests/conftest.py (first match wins):
#   1. Real environment variables (CI: GitHub Actions Postgres service,
#      see .github/workflows/deploy.yml)
#   2. This file (.env.test)
#   3. TEST_DB_* environment variables (see docs/test-setup.md)
#   4. Defaults matching docker-compose.test.yaml:
#      test_user:***@localhost:5434, database test_db
#
# SAFETY: the target database name MUST contain "test" — the migration
# tests execute DROP SCHEMA public CASCADE per test. Never point this at
# the development database on port 5432 (hextobin); conftest refuses.
#
# Typical local setup needs NO file at all — just start the test instance:
#   docker compose -f docker-compose.test.yaml up -d

DB_NAME=test_db
DB_USER=test_user
DB_PW=test_password
DB_HOST=localhost
DB_PORT=5434
